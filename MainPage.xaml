<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="calculatrice_MAUI.MainPage"
             Title="Calculatrice"
             BackgroundColor="#1C1C1E">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Style de base utilisé par tous les boutons de la calculatrice -->
            <Style x:Key="BaseButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2C2C2E" />
                <Setter Property="TextColor" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="HeightRequest" Value="60" />
            </Style>

            <!-- Style par défaut appliqué à tous les boutons -->
            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

            <!-- Boutons d'opération -->
            <Style x:Key="Op" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="BackgroundColor" Value="#FF9F0A" />
                <Setter Property="TextColor" Value="#1C1C1E" />
            </Style>

            <!-- Bouton égal -->
            <Style x:Key="Egal" TargetType="Button" BasedOn="{StaticResource Op}">
                <Setter Property="BackgroundColor" Value="#0A84FF" />
                <Setter Property="TextColor" Value="#FFFFFF" />
            </Style>

            <!-- Boutons d'actions secondaires -->
            <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="BackgroundColor" Value="#48484A" />
            </Style>

            <!-- Boutons compacts comme MC, MR, etc. -->
            <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="BackgroundColor" Value="#3A3A3C" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="CornerRadius" Value="19" />
            </Style>

            <!-- Boutons scientifiques -->
            <Style x:Key="Sci" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="BackgroundColor" Value="#262628" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Conteneur principal de l'interface utilisateur de la calculatrice -->
    <AbsoluteLayout>
        <!-- Panneau principal contenant l'écran et les boutons -->
        <Grid x:Name="Panneau" 
              AbsoluteLayout.LayoutBounds="0,0,1,1" 
              AbsoluteLayout.LayoutFlags="All"
              Padding="8" 
              RowSpacing="4" 
              ColumnSpacing="4" 
              RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Barre d'outils supérieure : angle, historique, copier -->
            <HorizontalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Center">
                <Button x:Name="BtnAngle" Text="Deg" Style="{StaticResource Chip}" Clicked="OnBasculeAngle" />
                <Button Text="Ans" Style="{StaticResource Chip}" Clicked="OnTouche" />
                <Button x:Name="BtnHisto" Text="Hist" Style="{StaticResource Chip}" Clicked="OnBasculeHistorique" />
                <Button Text="Copier" Style="{StaticResource Chip}" Clicked="OnCopier" />
            </HorizontalStackLayout>

            <!-- Écran d'affichage : expression en cours + résultat -->
            <Border Grid.Row="1" BackgroundColor="#2C2C2E" Stroke="#3A3A3C" StrokeShape="RoundRectangle 12" Padding="12,6">
                <VerticalStackLayout Spacing="2">
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <Label x:Name="LblExpression" Text="0" FontSize="15" TextColor="#8E8E93" HorizontalOptions="End" />
                    </ScrollView>
                    <Label x:Name="LblResultat" Text="0" FontSize="44" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalTextAlignment="End" LineBreakMode="HeadTruncation" />
                </VerticalStackLayout>
            </Border>

            <!-- Mémoire de la calculatrice -->
            <HorizontalStackLayout Grid.Row="2" Spacing="4" HorizontalOptions="Fill">
                <Label x:Name="LblMemoire" Text="M" TextColor="#FF9F0A" FontAttributes="Bold" IsVisible="False" VerticalOptions="Center" WidthRequest="16" />
                <Button Text="MC" Style="{StaticResource Chip}" Clicked="OnTouche" HorizontalOptions="FillAndExpand" />
                <Button Text="MR" Style="{StaticResource Chip}" Clicked="OnTouche" HorizontalOptions="FillAndExpand" />
                <Button Text="M+" Style="{StaticResource Chip}" Clicked="OnTouche" HorizontalOptions="FillAndExpand" />
                <Button Text="M−" Style="{StaticResource Chip}" Clicked="OnTouche" HorizontalOptions="FillAndExpand" />
                <Button Text="MS" Style="{StaticResource Chip}" Clicked="OnTouche" HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>

            <!-- Boutons de fonctions scientifiques -->
            <FlexLayout x:Name="PanneauScience" Grid.Row="3" Wrap="Wrap" JustifyContent="SpaceBetween">
                <Button x:Name="Science0" Text="2nde" Style="{StaticResource Sci}" FlexLayout.Basis="19%" BackgroundColor="#4B6584" Clicked="OnBasculeSeconde" />
                <Button x:Name="Science1" Text="sin(" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science2" Text="cos(" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science3" Text="tan(" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science4" Text="π" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science5" Text="ln(" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science6" Text="log(" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science7" Text="√" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science8" Text="x²" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science9" Text="xʸ" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science10" Text="(" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science11" Text="x!" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science12" Text="1/x" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science13" Text="x³" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
                <Button x:Name="Science14" Text=")" Style="{StaticResource Sci}" FlexLayout.Basis="19%" Clicked="OnTouche" />
            </FlexLayout>

            <!-- Clavier numérique + opérations de base -->
            <Grid Grid.Row="4" RowSpacing="4" ColumnSpacing="4" RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*">
                <Button Grid.Row="0" Grid.Column="0" Text="C" Style="{StaticResource Action}" Clicked="OnTouche" />
                <Button Grid.Row="0" Grid.Column="1" Text="⌫" Style="{StaticResource Action}" Clicked="OnTouche" />
                <Button Grid.Row="0" Grid.Column="2" Text="%" Style="{StaticResource Action}" Clicked="OnTouche" />
                <Button Grid.Row="0" Grid.Column="3" Text="÷" Style="{StaticResource Op}" Clicked="OnTouche" />

                <Button Grid.Row="1" Grid.Column="0" Text="7" Clicked="OnTouche" />
                <Button Grid.Row="1" Grid.Column="1" Text="8" Clicked="OnTouche" />
                <Button Grid.Row="1" Grid.Column="2" Text="9" Clicked="OnTouche" />
                <Button Grid.Row="1" Grid.Column="3" Text="×" Style="{StaticResource Op}" Clicked="OnTouche" />

                <Button Grid.Row="2" Grid.Column="0" Text="4" Clicked="OnTouche" />
                <Button Grid.Row="2" Grid.Column="1" Text="5" Clicked="OnTouche" />
                <Button Grid.Row="2" Grid.Column="2" Text="6" Clicked="OnTouche" />
                <Button Grid.Row="2" Grid.Column="3" Text="−" Style="{StaticResource Op}" Clicked="OnTouche" />

                <Button Grid.Row="3" Grid.Column="0" Text="1" Clicked="OnTouche" />
                <Button Grid.Row="3" Grid.Column="1" Text="2" Clicked="OnTouche" />
                <Button Grid.Row="3" Grid.Column="2" Text="3" Clicked="OnTouche" />
                <Button Grid.Row="3" Grid.Column="3" Text="+" Style="{StaticResource Op}" Clicked="OnTouche" />

                <Button Grid.Row="4" Grid.Column="0" Text="±" Clicked="OnTouche" />
                <Button Grid.Row="4" Grid.Column="1" Text="0" Clicked="OnTouche" />
                <Button Grid.Row="4" Grid.Column="2" Text="," Clicked="OnTouche" />
                <Button Grid.Row="4" Grid.Column="3" Text="=" Style="{StaticResource Egal}" Clicked="OnTouche" />
            </Grid>
        </Grid>

        <Button x:Name="FondHistorique" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" BackgroundColor="#80000000" IsVisible="False" Clicked="OnBasculeHistorique" />
        
        <Border x:Name="CarteHistorique" AbsoluteLayout.LayoutBounds="0.70,0.05,0.28,0.90" AbsoluteLayout.LayoutFlags="All" BackgroundColor="#2C2C2E" Stroke="#3A3A3C" StrokeShape="RoundRectangle 14" IsVisible="False" Padding="10">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Text="Historique" TextColor="#FFF" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Text="✕" Style="{StaticResource Action}" HeightRequest="30" WidthRequest="30" CornerRadius="15" Padding="0" Clicked="OnBasculeHistorique" />
                </Grid>
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="ListeHistorique" Spacing="4" />
                </ScrollView>
            </Grid>
        </Border>
    </AbsoluteLayout>
</ContentPage>