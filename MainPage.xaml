<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="calculatrice_MAUI.MainPage"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 Title="&lt;Eunice-calculator&gt;"
             BackgroundColor="git#1C1C1E">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="Accent">#0A84FF</Color>
            <Color x:Key="Texte">#FFFFFF</Color>
            <Color x:Key="TexteDoux">#8E8E93</Color>
            <Color x:Key="SurfaceHaute">#3A3A3C</Color>

            <Style x:Key="KBase" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2C2C2E" />
                <Setter Property="TextColor" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="BorderColor" Value="#4A4A4D" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>

            <Style x:Key="KOp" TargetType="Button" BasedOn="{StaticResource KBase}">
                <Setter Property="BackgroundColor" Value="#FF9F0A" />
                <Setter Property="TextColor" Value="#1C1C1E" />
                <Setter Property="BorderColor" Value="#FFC070" />
            </Style>

            <Style x:Key="KEgal" TargetType="Button" BasedOn="{StaticResource KOp}">
                <Setter Property="BackgroundColor" Value="#0A84FF" />
                <Setter Property="TextColor" Value="#FFFFFF" />
                <Setter Property="BorderColor" Value="#6BB4FF" />
            </Style>

            <Style x:Key="KAction" TargetType="Button" BasedOn="{StaticResource KBase}">
                <Setter Property="BackgroundColor" Value="#48484A" />
                <Setter Property="BorderColor" Value="#606064" />
            </Style>

            <Style x:Key="Memo" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#3A3A3C" />
                <Setter Property="TextColor" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="BorderColor" Value="#4A4A4D" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>

            <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Memo}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="Padding" Value="10,0" />
            </Style>

            <!-- Touches scientifiques : mêmes marges et même arrondi que les touches du clavier,
                 aucune hauteur fixe (la hauteur vient de la Grid, comme pour le clavier). -->
            <Style x:Key="Sci" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#262628" />
                <Setter Property="TextColor" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="BorderColor" Value="#3A3A3C" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="HeightRequest" Value="46" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>

        <!-- Les espaces entre blocs sont gérés par des marges (et non RowSpacing),
             pour qu'une ligne masquée ne laisse pas de vide. -->
        <Grid x:Name="Panneau"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              Padding="8,6"
              RowSpacing="0"
              ColumnSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.9*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>

            <HorizontalStackLayout x:Name="BarreOutils" Grid.Row="0" Margin="0,0,0,7" Spacing="6" HorizontalOptions="Center">
                <Button x:Name="BtnAngle" Text="Deg" Style="{StaticResource Chip}" Clicked="OnBasculeAngle" />
                <Button x:Name="BtnSci" Text="Sci" Style="{StaticResource Chip}" Clicked="OnBasculeScience" />
                <Button Text="Ans" Style="{StaticResource Chip}" Clicked="OnTouche" />
                <Button x:Name="BtnHisto" Text="Hist" Style="{StaticResource Chip}" Clicked="OnBasculeHistorique" />
                <Button Text="Copier" Style="{StaticResource Chip}" Clicked="OnCopier" />
            </HorizontalStackLayout>

            <Border x:Name="Affichage" Grid.Row="1"
                    Margin="0,0,0,7"
                    MinimumHeightRequest="90"
                    BackgroundColor="#2C2C2E"
                    Stroke="#3A3A3C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,10">
                <VerticalStackLayout Spacing="3" VerticalOptions="End">
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <Label x:Name="LblExpression"
                               Text="0"
                               FontSize="15"
                               TextColor="#8E8E93"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               LineBreakMode="NoWrap" />
                    </ScrollView>
                    <Label x:Name="LblResultat"
                           Text="0"
                           FontSize="42"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalTextAlignment="End"
                           VerticalTextAlignment="End"
                           LineBreakMode="HeadTruncation"
                           FontAutoScalingEnabled="True" />
                </VerticalStackLayout>
            </Border>

            <Grid x:Name="LigneMemoire" Grid.Row="2" Margin="2,0,2,7" ColumnSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label x:Name="LblMemoire" Text="M" TextColor="#FF9F0A" FontAttributes="Bold" FontSize="15" IsVisible="False" VerticalOptions="Center" WidthRequest="20" />
                <Button Grid.Column="1" Text="MC" Style="{StaticResource Memo}" Clicked="OnTouche" />
                <Button Grid.Column="2" Text="MR" Style="{StaticResource Memo}" Clicked="OnTouche" />
                <Button Grid.Column="3" Text="M+" Style="{StaticResource Memo}" Clicked="OnTouche" />
                <Button Grid.Column="4" Text="M−" Style="{StaticResource Memo}" Clicked="OnTouche" />
                <Button Grid.Column="5" Text="MS" Style="{StaticResource Memo}" Clicked="OnTouche" />
            </Grid>

            <!-- Touches scientifiques : enroulées dans une ScrollView pour rester accessibles
                 même quand l'écran manque de hauteur (paysage notamment). -->
            <ScrollView x:Name="DefileScience" Grid.Row="3" Margin="0,0,0,7" IsVisible="False"
                        VerticalScrollBarVisibility="Never">
                <Grid x:Name="PanneauScience" RowSpacing="7" ColumnSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="Science0" Grid.Row="0" Grid.Column="0" Text="2nde" Style="{StaticResource Sci}" BackgroundColor="#4B6584" Clicked="OnBasculeSeconde" />
                <Button x:Name="Science1" Grid.Row="0" Grid.Column="1" Text="sin(" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science2" Grid.Row="0" Grid.Column="2" Text="cos(" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science3" Grid.Row="0" Grid.Column="3" Text="tan(" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science4" Grid.Row="0" Grid.Column="4" Text="π" Style="{StaticResource Sci}" Clicked="OnTouche" />

                <Button x:Name="Science5" Grid.Row="1" Grid.Column="0" Text="ln(" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science6" Grid.Row="1" Grid.Column="1" Text="log(" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science7" Grid.Row="1" Grid.Column="2" Text="√" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science8" Grid.Row="1" Grid.Column="3" Text="x²" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science9" Grid.Row="1" Grid.Column="4" Text="xʸ" Style="{StaticResource Sci}" Clicked="OnTouche" />

                <Button x:Name="Science10" Grid.Row="2" Grid.Column="0" Text="(" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science11" Grid.Row="2" Grid.Column="1" Text="x!" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science12" Grid.Row="2" Grid.Column="2" Text="1/x" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science13" Grid.Row="2" Grid.Column="3" Text="x³" Style="{StaticResource Sci}" Clicked="OnTouche" />
                <Button x:Name="Science14" Grid.Row="2" Grid.Column="4" Text=")" Style="{StaticResource Sci}" Clicked="OnTouche" />
            </Grid>
            </ScrollView>

            <Grid x:Name="Clavier" Grid.Row="4" RowSpacing="7" ColumnSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Text="C" Style="{StaticResource KAction}" Clicked="OnTouche" />
                <Button Grid.Row="0" Grid.Column="1" Text="⌫" Style="{StaticResource KAction}" Clicked="OnTouche" />
                <Button Grid.Row="0" Grid.Column="2" Text="%" Style="{StaticResource KAction}" Clicked="OnTouche" />
                <Button Grid.Row="0" Grid.Column="3" Text="÷" Style="{StaticResource KOp}" Clicked="OnTouche" />

                <Button Grid.Row="1" Grid.Column="0" Text="7" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="1" Grid.Column="1" Text="8" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="1" Grid.Column="2" Text="9" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="1" Grid.Column="3" Text="×" Style="{StaticResource KOp}" Clicked="OnTouche" />

                <Button Grid.Row="2" Grid.Column="0" Text="4" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="2" Grid.Column="1" Text="5" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="2" Grid.Column="2" Text="6" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="2" Grid.Column="3" Text="−" Style="{StaticResource KOp}" Clicked="OnTouche" />

                <Button Grid.Row="3" Grid.Column="0" Text="1" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="3" Grid.Column="1" Text="2" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="3" Grid.Column="2" Text="3" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="3" Grid.Column="3" Text="+" Style="{StaticResource KOp}" Clicked="OnTouche" />

                <Button Grid.Row="4" Grid.Column="0" Text="±" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="4" Grid.Column="1" Text="0" Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="4" Grid.Column="2" Text="," Style="{StaticResource KBase}" Clicked="OnTouche" />
                <Button Grid.Row="4" Grid.Column="3" Text="=" Style="{StaticResource KEgal}" Clicked="OnTouche" />
            </Grid>

        </Grid>

        <Button x:Name="FondHistorique"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="#80000000"
                CornerRadius="0"
                IsVisible="False"
                Clicked="OnBasculeHistorique" />

        <Border x:Name="CarteHistorique"
                AbsoluteLayout.LayoutBounds="0.5,1,0.94,0.62"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="#2C2C2E"
                Stroke="#3A3A3C"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                IsVisible="False"
                Padding="10">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                    <Label Text="Historique" TextColor="#FFFFFF" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource KAction}" HeightRequest="30" WidthRequest="30" CornerRadius="15" Padding="0" Margin="0" ImageSource="trash.png" Clicked="OnViderHistorique" />
                    <Button Grid.Column="2" Text="✕" Style="{StaticResource KAction}" HeightRequest="30" WidthRequest="30" CornerRadius="15" Padding="0" Clicked="OnBasculeHistorique" />
                </Grid>
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="ListeHistorique" Spacing="4" />
                </ScrollView>
            </Grid>
        </Border>

    </AbsoluteLayout>

</ContentPage>